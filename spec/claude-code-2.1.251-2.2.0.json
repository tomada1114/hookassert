{
  "specVersion": "1",
  "claudeCodeRange": ">=2.1.251 <2.2.0",
  "defaults": {
    "hookTimeoutMs": 600000,
    "promptHookTimeoutMs": 30000,
    "agentHookTimeoutMs": 60000,
    "reducedTimeoutMs": {
      "UserPromptSubmit": 30000,
      "PreModelSwitch": 30000,
      "PostModelSwitch": 30000,
      "MessageDisplay": 10000,
      "SessionEnd": 1500
    }
  },
  "hookEnv": {
    "provided": [
      "CLAUDE_PROJECT_DIR",
      "CLAUDE_PLUGIN_ROOT",
      "CLAUDE_PLUGIN_DATA",
      "CLAUDE_CODE_REMOTE",
      "CLAUDE_CODE_BRIDGE_SESSION_ID",
      "CLAUDE_EFFORT"
    ]
  },
  "matcherSyntax": {
    "caseSensitive": true,
    "exactListPattern": "^[A-Za-z0-9_\\- ,|]+$",
    "narrowExactMatchEvents": ["FileChanged", "StopFailure"],
    "narrowExactListPattern": "^[A-Za-z0-9_|]+$",
    "rules": [
      {
        "id": "comma-separated-list",
        "sinceVersion": "2.1.191"
      },
      {
        "id": "hyphen-exact-match",
        "sinceVersion": "2.1.195"
      }
    ]
  },
  "knownTools": [
    "Bash",
    "PowerShell",
    "Edit",
    "Write",
    "Read",
    "Glob",
    "Grep",
    "WebFetch",
    "WebSearch",
    "Agent",
    "Workflow",
    "AskUserQuestion",
    "ExitPlanMode",
    "NotebookEdit"
  ],
