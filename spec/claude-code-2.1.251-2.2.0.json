      "honorsExit2": false,
      "jsonDecisions": [],
      "exitCodeEffects": [
        {
          "exitCode": 2,
          "effect": "non-blocking-error",
          "stderrTo": "user"
        },
        {
          "exitCode": 1,
          "effect": "non-blocking-error",
          "stderrTo": "user"
        }
      ],
      "payloadShape": {
        "verified": false,
        "requiredKeys": [
          "session_id",
          "cwd",
          "hook_event_name",
          "transcript_path",
          "source"
