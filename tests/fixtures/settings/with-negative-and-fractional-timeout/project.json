{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/negative-timeout.sh",
            "timeout": -1
          },
          {
            "type": "command",
            "command": "./scripts/fractional-timeout.sh",
            "timeout": 0.0005
          }
        ]
      }
    ]
  }
}
