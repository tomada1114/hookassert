{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tomada1114/hookassert/schema/spec.schema.json",
  "title": "hookassert versioned Claude Code hooks spec",
  "description": "Schema for spec/claude-code-<range>.json: the versioned, machine-readable source of truth for the Claude Code hooks contract that src/internal/spec/load.ts validates against.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "claudeCodeRange",
    "defaults",
    "hookEnv",
    "matcherSyntax",
    "knownTools",
    "events",
    "matcherTable"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Version of this schema's own shape, not of Claude Code."
    },
    "claudeCodeRange": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(>=|<=|>|<|=)\\d+\\.\\d+\\.\\d+(?:\\s+(>=|<=|>|<|=)\\d+\\.\\d+\\.\\d+)*$",
      "description": "The Claude Code version range this file's facts were transcribed against, as a space-separated list of comparator expressions (e.g. \">=2.1.251 <2.2.0\"). Deliberately narrow: no npm range operators (\"^\", \"~\", \"x\", \"||\")."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hookTimeoutMs",
        "promptHookTimeoutMs",
        "agentHookTimeoutMs",
        "reducedTimeoutMs"
      ],
      "properties": {
        "hookTimeoutMs": { "type": "integer", "minimum": 0 },
        "promptHookTimeoutMs": { "type": "integer", "minimum": 0 },
        "agentHookTimeoutMs": { "type": "integer", "minimum": 0 },
        "reducedTimeoutMs": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "hookEnv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided"],
      "properties": {
        "provided": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "matcherSyntax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseSensitive",
        "exactListPattern",
        "narrowExactMatchEvents",
        "narrowExactListPattern",
        "rules"
      ],
      "properties": {
        "caseSensitive": {
          "type": "boolean",
          "description": "Whether the exact-list and regex comparisons are case-sensitive. Does not affect exactListPattern."
        },
        "exactListPattern": {
          "type": "string",
          "minLength": 1,
          "description": "Must also compile as a JavaScript regular expression. This schema cannot express that check (JSON Schema draft-07 has no `format: \"regex\"` without the `ajv-formats` dependency, which this repository deliberately does not add) — `validateSpec` (guards.ts) enforces it instead."
        },
        "narrowExactMatchEvents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "narrowExactListPattern": {
          "type": "string",
          "minLength": 1,
          "description": "Must also compile as a JavaScript regular expression. This schema cannot express that check (JSON Schema draft-07 has no `format: \"regex\"` without the `ajv-formats` dependency, which this repository deliberately does not add) — `validateSpec` (guards.ts) enforces it instead."
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sinceVersion"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sinceVersion": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            }
          }
        }
      }
    },
    "knownTools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/eventSpec" }
    },
    "matcherTable": {
      "type": "array",
      "items": { "$ref": "#/$defs/matcherTableRow" }
    }
  },
  "$defs": {
    "matcherTargets": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "none" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "tool-name" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "field", "values"],
          "properties": {
            "kind": { "const": "enum" },
            "field": { "type": "string", "minLength": 1 },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "field"],
          "properties": {
            "kind": { "const": "field" },
            "field": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "exitCodeEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "effect", "stderrTo"],
      "properties": {
        "exitCode": { "type": "integer" },
        "effect": {
          "type": "string",
          "enum": ["block", "non-blocking-error", "ignored"]
        },
        "stderrTo": {
          "type": "string",
          "enum": ["claude", "user", "debug-log", "ignored"]
        }
      }
    },
    "payloadShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "requiredKeys"],
      "properties": {
        "verified": { "type": "boolean" },
        "verifiedAt": { "type": "string" },
        "againstVersion": { "type": "string" },
        "requiredKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "if": {
        "properties": { "verified": { "const": true } }
      },
      "then": {
        "required": ["verifiedAt", "againstVersion"]
      }
    },
    "eventSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcherTargets",
        "blockable",
        "honorsExit2",
        "jsonDecisions",
        "exitCodeEffects",
        "payloadShape"
      ],
      "properties": {
        "matcherTargets": { "$ref": "#/$defs/matcherTargets" },
        "blockable": { "type": "boolean" },
        "honorsExit2": { "type": "boolean" },
        "jsonDecisions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exitCodeEffects": {
          "type": "array",
          "items": { "$ref": "#/$defs/exitCodeEffect" }
        },
        "payloadShape": { "$ref": "#/$defs/payloadShape" }
      }
    },
    "matcherTableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "matcher", "matches", "doesNotMatch", "sinceVersion"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "matcher": { "type": "string" },
        "matches": {
          "type": "array",
          "items": { "type": "string" }
        },
        "doesNotMatch": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sinceVersion": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    }
  }
}
